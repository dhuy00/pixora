# ==============================================================================
# Pixora Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL + Drizzle ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pixora"

# ------------------------------------------------------------------------------
# 3. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Optional OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. Object Storage (Cloudflare R2 / Supabase Storage / AWS S3)
# ------------------------------------------------------------------------------
# Stores original reference images (<=10MB), compressed cel buffers, and rendered post assets
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="pixora-assets"
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL="http://localhost:3000/storage"

# ------------------------------------------------------------------------------
# 5. Rate Limiting (Upstash Redis - Optional in development)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
